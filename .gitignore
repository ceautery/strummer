# --- Node / TypeScript ---
node_modules/
dist/
build/
coverage/
*.tsbuildinfo
.turbo/
.pnpm-store/

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
*.egg-info/
.python-version

# transformers.js downloads embedding models into a cache dir.
.cache/

# --- Strummer build artifacts ---
# Built docset/index databases are reproducible artifacts, never committed.
/data/
/var/
# SQLite sidecar files (the committed fixtures/*.sqlite are single clean files).
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.dsidx-wal
*.dsidx-shm

# --- Secrets / env ---
.env
.env.*
!.env.example

# --- Dev-container harness (local only) ---
# Tooling used to create the Claude Code container that develops this project;
# not part of Strummer itself. Kept on disk, out of the repo.
/docker/
/docker-compose.yml

# --- macOS ---
.DS_Store

# --- Editors ---
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
