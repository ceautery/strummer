{
  "name": "@sackville/deps",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@renovatebot/pep440": "5.0.0",
    "@renovatebot/ruby-semver": "5.0.0",
    "@sackville/diff": "workspace:*",
    "@sackville/severity": "workspace:*",
    "fflate": "^0.8.3",
    "semver": "^7.8.1"
  },
  "devDependencies": {
    "@types/semver": "^7.7.1"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceautery/sackville.git",
    "directory": "packages/deps"
  }
