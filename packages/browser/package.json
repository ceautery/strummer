{
  "name": "@sackville/browser",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@axe-core/playwright": "4.11.3",
    "@sackville/api": "workspace:*",
    "@sackville/artifacts": "workspace:*",
    "@sackville/assert": "workspace:*",
    "@sackville/safety": "workspace:*",
    "@usebruno/lang": "^0.36.0",
    "axe-core": "4.11.4",
    "chrome-launcher": "1.2.1",
    "fflate": "^0.8.3",
    "lighthouse": "13.3.0",
    "pixelmatch": "7.2.0",
    "playwright-core": "1.60.0",
    "pngjs": "7.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/pngjs": "6.0.5"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceautery/sackville.git",
    "directory": "packages/browser"
  }
}
