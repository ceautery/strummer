{
  "name": "@strummer/cli",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "strummer": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@strummer/api": "workspace:*",
    "@strummer/browser": "workspace:*",
    "@strummer/core": "workspace:*",
    "@strummer/embed": "workspace:*",
    "@strummer/mutate": "workspace:*",
    "@strummer/safety": "workspace:*",
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13"
  }
}
