{
  "name": "@strummer/cli",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "strummer": "./dist/bin.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@strummer/api": "workspace:*",
    "@strummer/artifacts": "workspace:*",
    "@strummer/browser": "workspace:*",
    "@strummer/core": "workspace:*",
    "@strummer/coverage": "workspace:*",
    "@strummer/deps": "workspace:*",
    "@strummer/embed": "workspace:*",
    "@strummer/flake": "workspace:*",
    "@strummer/lsp": "workspace:*",
    "@strummer/mutate": "workspace:*",
    "@strummer/safety": "workspace:*",
    "@strummer/verdict": "workspace:*",
    "@strummer/verify": "workspace:*",
    "playwright-core": "1.60.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "fflate": "^0.8.3"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceautery/strummer.git",
    "directory": "packages/cli"
  }
}
