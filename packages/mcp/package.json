{
  "name": "@strummer/mcp",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "strummer-mcp": "./dist/bin.mjs",
    "strummer-api-mcp": "./dist/bin-api.mjs",
    "strummer-browser-mcp": "./dist/bin-browser.mjs",
    "strummer-deps-mcp": "./dist/bin-deps.mjs",
    "strummer-coverage-mcp": "./dist/bin-coverage.mjs",
    "strummer-flake-mcp": "./dist/bin-flake.mjs",
    "strummer-mutate-mcp": "./dist/bin-mutate.mjs"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/bin.ts src/bin-api.ts src/bin-browser.ts src/bin-deps.ts src/bin-coverage.ts src/bin-flake.ts src/bin-mutate.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@strummer/api": "workspace:*",
    "@strummer/artifacts": "workspace:*",
    "@strummer/browser": "workspace:*",
    "@strummer/core": "workspace:*",
    "@strummer/coverage": "workspace:*",
    "@strummer/deps": "workspace:*",
    "@strummer/embed": "workspace:*",
    "@strummer/flake": "workspace:*",
    "@strummer/mutate": "workspace:*",
    "@strummer/safety": "workspace:*",
    "playwright-core": "1.60.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "fflate": "^0.8.3"
  }
}
