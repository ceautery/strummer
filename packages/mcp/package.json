{
  "name": "sackville",
  "version": "0.0.0",
  "type": "module",
  "license": "Apache-2.0",
  "bin": {
    "sackville": "./dist/bin.mjs",
    "sackville-mcp": "./dist/bin.mjs",
    "sackville-docs-mcp": "./dist/bin-docs.mjs",
    "sackville-api-mcp": "./dist/bin-api.mjs",
    "sackville-browser-mcp": "./dist/bin-browser.mjs",
    "sackville-deps-mcp": "./dist/bin-deps.mjs",
    "sackville-coverage-mcp": "./dist/bin-coverage.mjs",
    "sackville-flake-mcp": "./dist/bin-flake.mjs",
    "sackville-mutate-mcp": "./dist/bin-mutate.mjs",
    "sackville-lsp-mcp": "./dist/bin-lsp.mjs",
    "sackville-verify-mcp": "./dist/bin-verify.mjs"
  },
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown src/index.ts src/docs.ts src/bin.ts src/bin-docs.ts src/bin-api.ts src/bin-browser.ts src/bin-deps.ts src/bin-coverage.ts src/bin-flake.ts src/bin-mutate.ts src/bin-lsp.ts src/bin-verify.ts --dts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@sackville/api": "workspace:*",
    "@sackville/artifacts": "workspace:*",
    "@sackville/coverage": "workspace:*",
    "@sackville/deps": "workspace:*",
    "@sackville/diff": "workspace:*",
    "@sackville/lsp": "workspace:*",
    "@sackville/mutate": "workspace:*",
    "@sackville/safety": "workspace:*",
    "@sackville/verdict": "workspace:*",
    "@sackville/verify": "workspace:*",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@sackville/browser": "workspace:*",
    "@sackville/core": "workspace:*",
    "@sackville/embed": "workspace:*",
    "@sackville/flake": "workspace:*",
    "playwright-core": "1.60.0"
  },
  "peerDependenciesMeta": {
    "@sackville/browser": {
      "optional": true
    },
    "@sackville/core": {
      "optional": true
    },
    "@sackville/embed": {
      "optional": true
    },
    "@sackville/flake": {
      "optional": true
    },
    "playwright-core": {
      "optional": true
    }
  },
  "devDependencies": {
    "@sackville/browser": "workspace:*",
    "@sackville/core": "workspace:*",
    "@sackville/embed": "workspace:*",
    "@sackville/flake": "workspace:*",
    "@types/better-sqlite3": "^7.6.13",
    "fflate": "^0.8.3",
    "playwright-core": "1.60.0"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "import": {
          "types": "./dist/index.d.mts",
          "default": "./dist/index.mjs"
        }
      }
    }
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ceautery/sackville.git",
    "directory": "packages/mcp"
  }
}
