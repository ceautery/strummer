{
  "mcpServers": {
    "sackville-mcp": {
      "command": "npx",
      "args": ["-y", "sackville-mcp"],
      "env": {
        "SACKVILLE_TOOLSETS": "api,deps,verify",
        "SACKVILLE_API_ALLOWED_HOSTS": "api.example.com",
        "SACKVILLE_DEPS_OSV_DB_DIR": "/abs/path/to/osv-snapshot"
      }
    }
  }
}
